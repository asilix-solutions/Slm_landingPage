# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only design references (full-page SVG snapshots, ~42 MB; supplied manually, never served)
/design-reference/screens/*
!/design-reference/screens/.gitkeep

# Claude Code local-only settings
/.claude/settings.local.json

# Owner-approved production media (2026-11-16): the exact files below are tracked so Render/GitHub builds render the full page.
# Everything else in these folders stays ignored. See docs/PRODUCTION_MEDIA.md.
# Phase 03C carousel photos: third-party / unverified usage rights, public repository.
# Kept LOCAL only — see docs/SOLUTIONS_LOCAL_IMAGES.md to restore them once rights are confirmed.
/public/images/solutions-carousel/*
!/public/images/solutions-carousel/01-field-hydrant-worker.webp
!/public/images/solutions-carousel/02-fire-extinguisher-presentation.webp
!/public/images/solutions-carousel/03-abc-extinguisher-sign.webp
/design-reference/assets/phase-03/solutions-carousel/source-exports/
/design-reference/notes/phase-03/solutions-carousel/four-unique-assets-contact-sheet.jpg
/design-reference/notes/phase-03/solutions-carousel/solutions-figma-capture-20261113.png
/docs/qa-screenshots/solutions-carousel/with-images-*.jpg

# Phase 04 project-control photo: third-party / unverified usage rights, public repository.
# Kept LOCAL only — see docs/PROJECT_CONTROL_LOCAL_IMAGE.md.
/public/images/project-control/*
!/public/images/project-control/request-intake.webp
/design-reference/assets/project-control/

# Phase 05 handoff: metrics background has unverified usage rights; full-page/overview exports are local context only.
/design-reference/assets/phase-05/metrics/
/design-reference/notes/phase-05/*.png
/public/images/metrics/*
!/public/images/metrics/metrics-full-dark-2400x1200.webp
# Phase 05A pinned-media handoff: reference video / previews and extra source media stay local.
/design-reference/notes/phase-05/*.jpg
/design-reference/notes/phase-05/reference-video/

# Phase 06 pricing handoff: wave artwork / reference exports have unverified distribution rights; kept LOCAL only.
/public/images/pricing/*
!/public/images/pricing/pricing-wave-true-vector.svg
/design-reference/assets/phase-06/
/design-reference/notes/phase-06/

# Phase 07C Q&A handoff: dashboard screenshot shows third-party branding, rights unverified; kept LOCAL only.
/public/images/qna/*
!/public/images/qna/dashboard-screenshot-lossless.webp
/design-reference/assets/phase-07c/
/design-reference/notes/phase-07c/
